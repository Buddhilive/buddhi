{
  "name": "buddhi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install-reqs": "pnpm install && pip3 install -r core/requirements.txt",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "export": "next export",
    "build:sidecar-winos": "pyinstaller -c -F --clean --name buddhi-x86_64-pc-windows-msvc --distpath src-tauri/bin/api core/main.py --add-data \"core/static;static\"",
    "build:sidecar-macos": "pyinstaller -c -F --clean --name buddhi-aarch64-apple-darwin --distpath src-tauri/bin/api core/main.py --add-data \"core/static;static\"",
    "build:sidecar-linux": "pyinstaller -c -F --clean --name buddhi-x86_64-unknown-linux-gnu --distpath src-tauri/bin/api core/main.py --add-data \"core/static;static\"",
    "build:icons": "pnpm tauri icon public/logos/app-icon.png"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
